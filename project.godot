; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but since it is a text-based format, you can easily tweak it.

config_version=5

[application]

config/name="Verdant Haven: Botanical Garden Simulator"
config/description="A cozy, deep botanical gardening simulator with 20 crop varieties, soil ecology, companion planting, and hybridization."
run/main_scene="res://scenes/core/GameWorld.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://assets/sprites/tools/almanac.png"

[autoload]

SignalBus="*res://scripts/autoloads/SignalBus.gd"
TimeManager="*res://scripts/autoloads/TimeManager.gd"
InventoryManager="*res://scripts/autoloads/InventoryManager.gd"
AlmanacManager="*res://scripts/autoloads/AlmanacManager.gd"
OfflineGrowthManager="*res://scripts/autoloads/OfflineGrowthManager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

